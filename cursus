#!/usr/bin/env bash
# Lanceur des projets 42 : `./cursus` ouvre le portail web, `./cursus <projet> [args]` lance directement.
# Seul prerequis : Docker (avec compose). Les projets C/C++ tournent dans l'image toolchain,
# les projets Docker sont lances avec docker compose depuis la machine hote.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
P="$ROOT/projects"
IMAGE="42-cursus/toolchain"
STACKS="inception transcendence cloud-1"

# Git Bash (Windows) : pas de conversion de chemins, et chemins hote au format C:/...
export MSYS_NO_PATHCONV=1
host_path() { if pwd -W >/dev/null 2>&1; then (cd "$1" && pwd -W); else echo "$1"; fi; }

B=$'\033[1m'; G=$'\033[32m'; Y=$'\033[33m'; C=$'\033[36m'; R=$'\033[31m'; N=$'\033[0m'
info() { echo "${C}==>${N} $*"; }
die()  { echo "${R}erreur:${N} $*" >&2; exit 1; }
ask()  { local r; read -r -p "$1 [${2:-}] " r || true; echo "${r:-${2:-}}"; }

# ---------------------------------------------------------------- outils

check_docker() {
    command -v docker >/dev/null || die "Docker n'est pas installe (https://docs.docker.com/get-docker/)"
    docker info >/dev/null 2>&1 || die "le daemon Docker ne repond pas : lance Docker puis recommence"
    docker compose version >/dev/null 2>&1 || die "le plugin docker compose est requis"
}

toolchain() {
    docker image inspect "$IMAGE" >/dev/null 2>&1 && return
    info "Construction de l'image outils $IMAGE (une seule fois)..."
    docker build -q -t "$IMAGE" "$(host_path "$ROOT/launcher")" >/dev/null
}

# in_box <dossier> <script> [args...] : lance le script dans l'image outils, dossier monte sur /work,
# les args restent separes ("$@" dans le script)
in_box() {
    local dir="$1" script="$2"; shift 2
    local extra=(${DOCKER_ARGS[@]+"${DOCKER_ARGS[@]}"}); DOCKER_ARGS=()
    local tty=(-i); [ -t 0 ] && [ -t 1 ] && tty=(-it)
    toolchain
    docker run --rm "${tty[@]}" --init -v "$(host_path "$dir"):/work" -w /work \
        ${extra[@]+"${extra[@]}"} "$IMAGE" bash -c "$script" _ "$@"
}
DOCKER_ARGS=()

# Compile puis lance ./<bin> ; les args tapes dans le menu gardent leurs guillemets
build_run() {
    local dir="$1" bin="$2"; shift 2
    in_box "$dir" "make -s && exec ./$bin \"\$@\"" "$@"
}
split_args() { set -f; eval "ARGV=($1)"; set +f; }

rand() { (set +o pipefail; LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c "${1:-20}"); }

# ---------------------------------------------------------------- C / C++

run_philo() {
    local v="${1:-}"; shift || true
    [ -z "$v" ] && v="$(ask "Version (philo / philo_bonus) ?" philo)"
    [ -d "$P/philosophers/$v" ] || die "version inconnue : $v"
    ARGV=("$@")
    [ $# -eq 0 ] && split_args "$(ask "Arguments : nb_philo t_die t_eat t_sleep [nb_repas] ?" "5 800 200 200 7")"
    build_run "$P/philosophers/$v" "$v" ${ARGV[@]+"${ARGV[@]}"}
}

cpp_bin() { sed -n 's/^NAME[[:space:]]*:*=[[:space:]]*//p' "$1/Makefile" | head -1; }

run_cpp() {
    local mod="${1:-}" ex="${2:-}"; shift 2 2>/dev/null || shift $#
    if [ -z "$mod" ]; then
        echo "Modules : $(cd "$P/cpp-modules" && ls -d cpp_* | tr '\n' ' ')"
        mod="$(ask "Module ?" cpp_00)"
    fi
    [[ "$mod" =~ ^[0-9]+$ ]] && mod="$(printf 'cpp_%02d' "$((10#$mod))")"
    [ -d "$P/cpp-modules/$mod" ] || die "module inconnu : $mod"
    if [ -z "$ex" ]; then
        echo "Exercices : $(cd "$P/cpp-modules/$mod" && ls -d ex* | tr '\n' ' ')"
        ex="$(ask "Exercice ?" ex00)"
    fi
    [[ "$ex" =~ ^[0-9]+$ ]] && ex="$(printf 'ex%02d' "$((10#$ex))")"
    local dir="$P/cpp-modules/$mod/$ex"
    [ -d "$dir" ] || die "exercice inconnu : $mod/$ex"
    local bin; bin="$(cpp_bin "$dir")"
    ARGV=("$@")
    [ $# -eq 0 ] && [ -t 0 ] && split_args "$(ask "Arguments de ./$bin (Entree = aucun) ?" "")"
    build_run "$dir" "$bin" ${ARGV[@]+"${ARGV[@]}"}
}

run_webserv() {
    local conf="${1:-files/valid/webServ.conf}"
    local port; port="$(sed -n 's/^[[:space:]]*listen[[:space:]]\{1,\}\([0-9]\{1,\}\);.*/\1/p' "$P/webserv/$conf" | head -1)"
    DOCKER_ARGS=(-p "${port:-1045}:${port:-1045}")
    info "webserv sur ${B}http://localhost:${port:-1045}${N}  (Ctrl+C pour arreter)"
    build_run "$P/webserv" webserv "$conf"
}

# Bibliotheques : compilees puis appelees par un petit programme de demo (launcher/demos/)
run_lib() {
    local lib="${1:-}"; shift || true
    [ -z "$lib" ] && lib="$(ask "Bibliotheque (libft / ft_printf / get_next_line) ?" libft)"
    local D=/cursus/launcher/demos L=/cursus/projects
    DOCKER_ARGS=(-v "$(host_path "$ROOT"):/cursus")
    case "$lib" in
        libft)
            in_box "$ROOT/launcher" "make -s -C $L/libft bonus >/dev/null && cc -Wall -Wextra -Werror $D/libft_demo.c \
                -I$L/libft $L/libft/libft.a -o /tmp/demo && exec /tmp/demo \"\$@\"" "$@" ;;
        printf|ft_printf)
            in_box "$ROOT/launcher" "make -s -C $L/ft_printf >/dev/null && cc -Wall -Wextra $D/printf_demo.c \
                -I$L/ft_printf $L/ft_printf/libftprintf.a -o /tmp/demo && exec /tmp/demo" ;;
        gnl|get_next_line)
            local bs="${1:-42}" file="${2:-projects/get_next_line/get_next_line.c}"
            in_box "$ROOT/launcher" "cc -Wall -Wextra -Werror -D BUFFER_SIZE=$bs $D/gnl_demo.c \
                $L/get_next_line/get_next_line.c $L/get_next_line/get_next_line_utils.c -I$L/get_next_line \
                -o /tmp/demo && exec /tmp/demo /cursus/$file" ;;
        *) die "bibliotheque inconnue : $lib" ;;
    esac
}

run_push_swap() {
    local n="${1:-100}"
    in_box "$P/push_swap" 'make -s all >/dev/null 2>&1 || make all
        ARG=$(shuf -i 1-100000 -n "$1" | tr "\n" " ")
        echo "$1 nombres aleatoires"
        echo "coups       : $(./push_swap $ARG | wc -l)   (bareme : < 700 pour 100, < 5500 pour 500)"
        echo "checker     : $(./push_swap $ARG | ./checker $ARG)"' "$n"
}

run_minitalk() {
    local msg="${*:-Bonjour depuis le client, 42 signaux SIGUSR1/SIGUSR2 plus tard...}"
    in_box "$P/minitalk" 'make -s all >/dev/null 2>&1 || make all
        ./server > /tmp/out & sleep 0.5
        pid=$(sed -n "s/.*server is \([0-9]*\).*/\1/p" /tmp/out)
        echo "serveur lance, PID $pid"; echo "client -> \"$1\""
        ./client "$pid" "$1"; sleep 0.5
        echo "--- recu par le serveur :"; tail -n +2 /tmp/out; echo; kill "$pid"' "$msg"
}

run_minishell() {
    info "minishell : tape exit pour quitter"
    in_box "$P/minishell" "make -s all VERBOSE= >/dev/null 2>&1 || make all VERBOSE=; exec ./minishell"
}

# fdf / cub3d : MiniLibX dans un ecran virtuel, affiche dans le navigateur par noVNC
run_gui() {
    local prj="$1" bin="$2" arg="$3"
    # un seul ecran a la fois : sinon le suivant ne peut pas prendre les ports 6080/6081
    docker ps -q --filter "publish=6080" | xargs -r docker rm -f >/dev/null 2>&1 || true
    DOCKER_ARGS=(--name 42-cursus-gui -p 127.0.0.1:6080:6080 -p 127.0.0.1:6081:6081
                 -v "$(host_path "$ROOT/launcher"):/launcher:ro")
    info "$prj s'affiche dans le navigateur : ${B}http://localhost:6080/vnc.html?autoconnect=1&resize=scale${N}"
    info "Ctrl+C ici pour arreter"
    in_box "$P/$prj" "make -s ${4:-} >/dev/null 2>&1 || make ${4:-}; exec sh /launcher/gui.sh ./$bin \"\$@\"" "$arg"
}
run_fdf()   { run_gui fdf fdf "includes/test_maps/${1:-42}.fdf"; }
run_cub3d() {
    case "${1:-}" in bonus) run_gui cub3d cub3D_bonus maps/map_b.cub bonus ;;
                     *)     run_gui cub3d cub3D maps/map_m.cub ;; esac
}

# ---------------------------------------------------------------- stacks Docker

compose() {
    case "$1" in
        inception)     (cd "$P/inception/srcs" && shift && docker compose -p inception --env-file .env \
                            -f docker-compose.yml -f "$(host_path "$ROOT/launcher")/inception.override.yml" "$@") ;;
        transcendence) (cd "$P/ft_transcendence" && shift && docker compose -p transcendence --env-file .env \
                            -f docker-compose.yml -f "$(host_path "$ROOT/launcher")/transcendence.override.yml" "$@") ;;
        cloud-1)       (cd "$P/cloud-1/docker" && shift && docker compose -p cloud-1 "$@") ;;
        *) die "stack inconnue : $1" ;;
    esac
}

prep_inception() {
    local s="$P/inception/srcs"
    [ -f "$s/.env" ] || sed -e 's/^DOMAIN_NAME=.*/DOMAIN_NAME=localhost/' \
                            -e 's#^WP_URL=.*#WP_URL=https://localhost#' "$s/.env.exemple" > "$s/.env"
    [ -d "$s/secrets" ] && return
    info "Generation des secrets (srcs/secrets/, ignores par git)"
    mkdir -p "$s/secrets"
    local f; for f in mysql_root_password mysql_password wp_admin_password redis_password ftp_password; do
        rand > "$s/secrets/$f"
    done
    local pw; pw="$(rand)"
    docker run --rm httpd:2.4-alpine htpasswd -nbB admin "$pw" | cut -d: -f2 | tr -d '\r\n' \
        > "$s/secrets/portainer_admin_password_hash"
    echo "$pw" > "$s/secrets/portainer_admin_password"
}

prep_transcendence() {
    local d="$P/ft_transcendence"
    [ -f "$d/.env" ] || cp "$d/.denv" "$d/.env"
}

prep_cloud1() {
    local d="$P/cloud-1/docker"
    if [ ! -f "$d/.env" ]; then
        printf 'MARIADB_ROOT_PASSWORD=%s\nDB_NAME=wordpress\nDB_USER=wordpress\nDB_PASSWORD=%s\nDOMAIN=localhost\n' \
            "$(rand)" "$(rand)" > "$d/.env"
    fi
    if [ ! -f "$d/certs/cloud1.crt" ]; then
        mkdir -p "$d/certs"
        in_box "$d/certs" "openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
            -keyout cloud1.key -out cloud1.crt -subj /CN=localhost 2>/dev/null" </dev/null
    fi
}

# Meme etape que le role Ansible `app` : installer WordPress par WP-CLI, sans ecran d'installation
install_cloud1_wp() {
    local wp=(run --rm -T wpcli wp)
    compose cloud-1 "${wp[@]}" core is-installed >/dev/null 2>&1 && return
    local i; for i in $(seq 1 10); do compose cloud-1 "${wp[@]}" core version >/dev/null 2>&1 && break; sleep 3; done
    local pw; pw="$(rand)"
    compose cloud-1 "${wp[@]}" core install --url=https://localhost --title=Cloud-1 \
        --admin_user=admin --admin_password="$pw" --admin_email=admin@example.com --skip-email >/dev/null 2>&1
    echo "WP_ADMIN_PASSWORD=$pw" >> "$P/cloud-1/docker/.env"
    info "WordPress installe (admin / WP_ADMIN_PASSWORD dans projects/cloud-1/docker/.env)"
}

stack_up() {
    local s="$1"
    for other in $STACKS; do
        [ "$other" != "$s" ] && [ -n "$(compose "$other" ps -q 2>/dev/null)" ] && {
            info "Arret de $other (ports partages)"; compose "$other" down; }
    done
    case "$s" in
        inception)     prep_inception ;;
        transcendence) prep_transcendence ;;
        cloud-1)       prep_cloud1 ;;
    esac
    info "Demarrage de $s (le premier build peut prendre plusieurs minutes)..."
    compose "$s" up -d --build --wait || { compose "$s" ps; die "$s n'est pas demarre correctement (./cursus logs $s)"; }
    [ "$s" = cloud-1 ] && install_cloud1_wp
    echo
    case "$s" in
        inception)     echo "  WordPress   ${B}https://localhost${N}   (admin : gmarquis / srcs/secrets/wp_admin_password)"
                       echo "  Portainer   ${B}https://localhost:9443${N}   (admin / srcs/secrets/portainer_admin_password)" ;;
        transcendence) echo "  Application ${B}https://localhost:8001${N}"
                       echo "  Grafana     ${B}http://localhost:3000${N}    Prometheus ${B}http://localhost:9090${N}    Adminer ${B}http://localhost:8080${N}" ;;
        cloud-1)       echo "  WordPress   ${B}https://localhost${N}    phpMyAdmin ${B}https://localhost/phpmyadmin/${N}" ;;
    esac
    echo "  Certificats auto-signes : accepter l'avertissement du navigateur."
    echo "  Arreter : ${B}./cursus stop $s${N}"
}

# ---------------------------------------------------------------- menu

usage() {
    cat <<EOF2
${B}42-cursus${N} — lanceur des projets de l'ecole 42

  ./cursus                          portail web (le graph des projets) sur http://localhost:4242
  ./cursus menu                     meme chose dans le terminal

  ./cursus libft | ft_printf        demo de la bibliotheque
  ./cursus gnl [BUFFER_SIZE] [fichier]
  ./cursus push_swap [n]            tri de n nombres aleatoires, nombre de coups, checker
  ./cursus minitalk [message]       serveur + client par signaux UNIX
  ./cursus fdf [carte]              wireframe MiniLibX, affiche sur http://localhost:6080
  ./cursus philo [philo|philo_bonus] [args]   ex : ./cursus philo philo 5 800 200 200 7
  ./cursus minishell                shell interactif
  ./cursus cub3d [bonus]            raycaster MiniLibX, affiche sur http://localhost:6080
  ./cursus cpp [module] [exercice] [args]     ex : ./cursus cpp 09 01 "8 9 * 9 - 9 - 9 - 4 - 1 +"
  ./cursus webserv [config]         serveur HTTP sur http://localhost:1045
  ./cursus inception | transcendence | cloud-1   stacks Docker

  ./cursus status | stop <stack|portal> | logs <stack> | stop-all
  ./cursus clean                    arrete tout, supprime volumes et images
EOF2
}

menu() {
    while true; do
        echo
        echo "${B}  42-cursus${N}"
        echo "  ${Y}Bibliotheques et algo${N}"
        echo "    1) libft        2) ft_printf      3) get_next_line    4) push_swap"
        echo "  ${Y}Systeme${N}"
        echo "    5) minitalk     6) philosophers   7) minishell"
        echo "  ${Y}Graphique${N}"
        echo "    8) fdf          9) cub3d"
        echo "  ${Y}C++${N}"
        echo "   10) cpp-modules 11) webserv"
        echo "  ${Y}Docker / DevOps${N}"
        echo "   12) inception   13) ft_transcendence   14) cloud-1"
        echo "    s) etat des stacks    x) tout arreter    q) quitter"
        case "$(ask "Choix ?" "")" in
            1) run_lib libft ;;      2) run_lib ft_printf ;;  3) run_lib gnl ;;
            4) run_push_swap "$(ask "Combien de nombres ?" 100)" ;;
            5) run_minitalk "$(ask "Message ?" "Salut 42")" ;;
            6) run_philo ;;          7) run_minishell ;;
            8) run_fdf "$(ask "Carte (42, mars, julia, pyramide...) ?" 42)" ;;
            9) run_cub3d "$(ask "Version (mandatory / bonus) ?" mandatory)" ;;
            10) run_cpp ;;           11) run_webserv ;;
            12) stack_up inception ;; 13) stack_up transcendence ;; 14) stack_up cloud-1 ;;
            s) status ;;
            x) stop_all ;;
            q|"") exit 0 ;;
            *) echo "choix inconnu" ;;
        esac
    done
}

# ---------------------------------------------------------------- portail web

PORTAL="42-cursus-portal"

# Chemin du depot tel que le daemon Docker le voit : Docker Desktop sous Windows expose C:\ en
# /run/desktop/mnt/host/c ; ailleurs, c'est le meme chemin que sur la machine
daemon_path() {
    local h; h="$(host_path "$ROOT")"
    case "$h" in
        [A-Za-z]:/*) echo "/run/desktop/mnt/host/$(echo "${h:0:1}" | tr 'A-Z' 'a-z')${h:2}" ;;
        *)           echo "$h" ;;
    esac
}

open_url() {
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) cmd.exe /c start "" "$1" >/dev/null 2>&1 ;;
        Darwin)               open "$1" ;;
        *)                    xdg-open "$1" >/dev/null 2>&1 || true ;;
    esac
}

portal() {
    local dp; dp="$(daemon_path)"
    info "Construction du portail..."
    docker build -q -t 42-cursus/portal "$(host_path "$ROOT/launcher/portal")" >/dev/null
    toolchain
    docker rm -f "$PORTAL" >/dev/null 2>&1 || true
    docker run -d --name "$PORTAL" -p 127.0.0.1:4242:4242 \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v "$(host_path "$ROOT"):$dp" -e CURSUS_ROOT="$dp" 42-cursus/portal >/dev/null
    info "Portail : ${B}http://localhost:4242${N}   (arret : ./cursus stop portal)"
    [ -z "${CURSUS_NO_BROWSER:-}" ] && open_url "http://localhost:4242"
}

# Point d'entree du terminal web : lance la commande demandee par la page, puis garde la sortie
# a l'ecran au lieu de fermer la session
web() {
    [ $# -eq 0 ] && { menu; return; }
    echo "${C}\$ ./cursus $*${N}"; echo
    ( main "$@" ) || true
    echo; echo "${G}-- termine.${N} Relance depuis la page, ou ferme ce terminal."
    read -r _ || true
}

stop_all() {
    for s in $STACKS; do compose "$s" down 2>/dev/null || true; done
    docker ps -q --filter "ancestor=$IMAGE" | xargs -r docker stop >/dev/null
}

status() {
    for s in $STACKS; do
        echo "${B}$s${N}"; compose "$s" ps --format 'table {{.Service}}\t{{.State}}\t{{.Health}}' 2>/dev/null | sed 's/^/  /'
    done
}

clean() {
    stop_all
    for s in $STACKS; do compose "$s" down -v --remove-orphans 2>/dev/null || true; done
    docker rm -f "$PORTAL" >/dev/null 2>&1 || true
    docker image rm "$IMAGE" 42-cursus/portal 2>/dev/null || true
}

main() {
    case "${1:-}" in -h|--help|help) usage; exit 0 ;; esac
    check_docker
    local cmd="${1:-}"; shift || true
    case "$cmd" in
        "")                    portal ;;
        menu)                  menu ;;
        web)                   web "$@" ;;
        stop-all)              stop_all ;;
        stop)                  [ "${1:-}" = portal ] && { docker rm -f "$PORTAL" >/dev/null; exit 0; }
                               compose "${1:?stack ?}" down ;;
        libft|ft_printf|printf|gnl|get_next_line) run_lib "$cmd" "$@" ;;
        push_swap)             run_push_swap "$@" ;;
        minitalk)              run_minitalk "$@" ;;
        minishell)             run_minishell ;;
        fdf)                   run_fdf "$@" ;;
        cub3d|cub3D)           run_cub3d "$@" ;;
        philo|philosophers)    run_philo "$@" ;;
        cpp|cpp-modules)       run_cpp "$@" ;;
        webserv)               run_webserv "$@" ;;
        inception|cloud-1)     stack_up "$cmd" ;;
        transcendence|ft_transcendence) stack_up transcendence ;;
        logs)                  compose "${1:?stack ?}" logs -f --tail=100 ;;
        status)                status ;;
        clean)                 clean ;;
        *)                     usage; exit 1 ;;
    esac
}

main "$@"
